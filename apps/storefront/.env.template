# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=dk

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=https://localhost:8000

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# PostHog analytics project token and ingestion host. The token is a
# public, client-facing identifier, but you should still keep it
# project-scoped and rotate it when you no longer want browser
# sessions to use the old one. Leave the token empty to disable
# storefront + backend analytics (events become no-ops on the server
# side and the SDK refuses to init on the client side).
#
# SECURITY: the token below is the public demo project used by the
# upstream PostHog PR. Do not ship it to production — the same token
# is visible in any GitHub UI for the project, which means anyone with
# the URL can fire events into your project. Replace it with your own
# project token before going live.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Node environment (development, production, etc.)
NODE_ENV=development
